# Secrets. Never commit these.
.env
.env.*
!.env.example
# The secrets/ directory holds one file per credential, populated per
# deployment. The real files are ignored; the templates and README are not.
secrets/*
!secrets/README.md
!secrets/.gitignore
!secrets/*.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Node
node_modules/
.next/
out/
.pnpm-store/
*.tsbuildinfo
frontend/playwright-report/
frontend/test-results/
frontend/.playwright-browsers/

# The generated API types are committed, not ignored, and this rule used to say
# the opposite while naming a `pnpm sync-types` script that did not exist. The
# frontend image builds from `./frontend` alone -- no Python, no uv, no backend
# source -- so types produced from the backend's OpenAPI document cannot be
# build output there: a fresh clone would fail `pnpm build`. Committing them
# also makes the diff the place a contract change gets reviewed, and lets CI
# regenerate and fail on a difference. See scripts/generate-api-types.sh.

# Data that must never reach the repository. Anchored to the repo root so each
# matches the runtime data directory, not a source folder that shares the name:
# unanchored, `logs/` hid frontend/src/features/logs/ and `models/` hid the
# entire models feature from git.
/models/
/data/
/logs/
*.mmdb

# Claude Code
.claude/
CLAUDE.md

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
