# Secrets. Never commit these.
.env
.env.*
!.env.example
# The secrets/ directory holds one file per credential, populated per
# deployment. The real files are ignored; the templates and README are not.
secrets/*
!secrets/README.md
!secrets/.gitignore
!secrets/*.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Node
node_modules/
.next/
out/
.pnpm-store/
*.tsbuildinfo

# Generated API types are build output, regenerated by `pnpm sync-types`
frontend/src/lib/generated/*
!frontend/src/lib/generated/.gitkeep

# Data that must never reach the repository
models/
data/
# Anchored to the repo root: unanchored, `logs/` also matched the source
# directory frontend/src/features/logs/ and hid it from git. (`models/` and
# `data/` have the same latent issue but are left as-is here.)
/logs/
*.mmdb

# Claude Code
.claude/
CLAUDE.md

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
