# Secrets. Never commit these.
.env
.env.*
!.env.example
# The secrets/ directory holds one file per credential, populated per
# deployment. The real files are ignored; the templates and README are not.
secrets/*
!secrets/README.md
!secrets/.gitignore
!secrets/*.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Node
node_modules/
.next/
out/
.pnpm-store/
*.tsbuildinfo

# Generated API types are build output, regenerated by `pnpm sync-types`
frontend/src/lib/generated/*
!frontend/src/lib/generated/.gitkeep

# Data that must never reach the repository. Anchored to the repo root so each
# matches the runtime data directory, not a source folder that shares the name:
# unanchored, `logs/` hid frontend/src/features/logs/ and `models/` hid the
# entire models feature from git.
/models/
/data/
/logs/
*.mmdb

# Claude Code
.claude/
CLAUDE.md

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
