# Copy to .env and fill in. Never commit .env.
# Secrets do NOT belong here in production: they are mounted as files under
# /run/secrets and read via pydantic-settings `secrets_dir`. See
# docs/architecture/deployment.md section 10.

# --- Environment ---------------------------------------------------------
ENV=development                 # development | production
AUTH_MODE=dev                   # tailnet | local | dev
                                # dev refuses to start when ENV=production

# Serving the internal schema is opt-in, so leaving this alone fails closed.
# Ignored entirely when ENV=production.
EXPOSE_OPENAPI=false

# --- Networking ----------------------------------------------------------
# Tailscale address of the Mac Studio. Used for host-side port binding, so
# that proxy-facing ports are never published on 0.0.0.0.
TAILNET_IP=127.0.0.1
PROXY_HOSTNAME=api.nexus.rcsl.online

# --- Datastores ----------------------------------------------------------
# DATABASE_URL is a secret (it carries a password) and is NOT set here for
# Compose: each service mounts its own least-privilege account's URL as the
# `database_url` secret file (see the Secrets note at the foot of this file and
# ./secrets/README.md). Setting it here would override the mounted secret,
# because an environment variable outranks a file secret in pydantic-settings.
#
# For running the backend directly, outside Compose, uncomment and point it at
# your local Postgres:
#   DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://redis:6379/0

# `memory` is per-process, so rate limits would be counted per worker rather
# than per key. Settings refuses to start with it when ENV=production. Use it
# only when running the backend outside Compose, where there is no Redis.
CACHE_BACKEND=redis

# --- Model runtimes ------------------------------------------------------
# Runtimes run natively on the macOS host, not in Docker: containers on
# macOS cannot reach the GPU. See docs/ARCHITECTURE.md section 0.1.
OLLAMA_BASE_URL=http://host.docker.internal:11434
MLX_BASE_URL=http://host.docker.internal:8080

# Where the MLX adapter's downloads land. HF_HOME points at a bind mount, and
# HF_CACHE_HOST_PATH is the host directory behind it: on the Mac Studio set this
# to the native mlx_lm.server's HuggingFace cache (e.g.
# /Users/<runtime-account>/.cache/huggingface) so a model downloaded through the
# admin UI is the same one the host server then serves. The default keeps
# `docker compose config` working on a dev machine that has no such cache.
HF_CACHE_HOST_PATH=./data/hf-cache

# --- The compute node ----------------------------------------------------
# Phase 1 runs on one machine, and that node is named here rather than
# registered through the API: a node record is an address the platform will
# make outbound requests to, so a write endpoint has to ship alongside the
# SSRF guard (security.md section 7.2). The admin services ensure this row
# exists on every start.
#
# NODE_TOTAL_MEMORY_GB must match the real machine. The memory budget refuses
# a model load that would exceed a fraction of it: too high and the guardrail
# lets the host into swap, too low and models that would fit are refused.
NODE_ID=local
NODE_NAME=local
NODE_TOTAL_MEMORY_GB=64

# How often the admin app probes each node and writes the observed status, so a
# routing requirement of an online node reflects reality rather than the value
# provisioning wrote once. Runs in the admin entrances only (the gateway may not
# write the nodes table). Zero or negative disables it.
NODE_HEARTBEAT_INTERVAL_SECONDS=30

# --- Frontend ------------------------------------------------------------
ADMIN_API_URL=http://admin-tailnet:8001

# Origin of the management UI, used to build invitation and password reset
# links. Configured rather than taken from the request, because the link is
# issued on whichever entrance the administrator happens to be using and must
# always point at the public one: a tailnet URL handed to someone who has no
# Tailscale is a link they cannot open.
ADMIN_BASE_URL=http://localhost:3000

# --- Sessions and invitations -------------------------------------------
# Names and units match the Settings fields exactly. They previously read
# SESSION_ABSOLUTE_TTL=12h and friends, which matched no field and parsed as
# no integer, so setting them was a silent no-op that looked configured.
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_IDLE_TTL_SECONDS=3600
INVITATION_TTL_SECONDS=259200

# How long a generated-but-unproved TOTP secret is held. Short on purpose: an
# abandoned enrolment must not leave a usable second factor waiting, and an
# expiry only costs the user a re-scan.
TOTP_ENROLMENT_TTL_SECONDS=600

# Shown by the authenticator app next to the account.
TOTP_ISSUER=RCSL AI Nexus

# --- Cookies -------------------------------------------------------------
# The `__Host-` prefix binds a cookie to this exact origin and requires
# Secure, so browsers discard it over plain HTTP. Turning COOKIE_SECURE off
# for local development therefore drops the prefix as well, and the frontend
# must be told the new name:
#
#   COOKIE_SECURE=false
#   NEXT_PUBLIC_CSRF_COOKIE=nexus_csrf
#
# Settings refuses COOKIE_SECURE=false when ENV=production.
COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-nexus_session
CSRF_COOKIE_NAME=__Host-nexus_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# --- Source restriction --------------------------------------------------
# Enforced in the application, since the public entrance is an nginx proxy
# rather than a CDN. Refuses to start in production if the database below is
# missing, rather than silently allowing every country.
ALLOWED_COUNTRIES=TW,AU
GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb

# --- Bootstrap -----------------------------------------------------------
# Creates the first admin on first login through the TAILNET entrance only,
# and only while the users table is empty. Inert thereafter.
#
# Under AUTH_MODE=dev there is no tailscale serve to inject an identity
# header, so DEV_TAILNET_LOGIN is substituted for it and everything after that
# runs unchanged. Set this to the same value to bootstrap locally.
BOOTSTRAP_ADMIN_LOGIN=
DEV_TAILNET_LOGIN=dev@localhost

# --- Resource guardrails -------------------------------------------------
# With no CDN in front of this deployment these are the only defence against
# a single caller making the machine unresponsive.
MAX_CONCURRENT_INFERENCE=2
MAX_TOKENS_CEILING=4096
MAX_CONTEXT_LENGTH=32768
REQUEST_TIMEOUT_SECONDS=300

# --- Non-secret datastore identity ---------------------------------------
# The Postgres role and database names are not secrets; the superuser password
# is (see the Secrets note below). These are read by the postgres container.
POSTGRES_USER=nexus
POSTGRES_DB=nexus

# Ceiling on how far ahead an API key may be set to expire. Expiry exists to
# force rotation, so a key cannot be issued to outlive this.
API_KEY_MAX_LIFETIME_DAYS=365

# --- Secrets -------------------------------------------------------------
# NONE of the following belong in this file for a Compose deployment. They are
# provided as files under ./secrets, mounted at /run/secrets, and read through
# pydantic-settings `secrets_dir`. See ./secrets/README.md.
#
# They are deliberately NOT listed here even commented with real names, because
# an environment variable outranks a file secret: a value left here would
# silently override the mounted one. Settings also refuses the shipped
# placeholders when ENV=production, so a stray value fails closed rather than
# weakening the control.
#
#   database_url          (per service: gateway / admin / owner accounts)
#   postgres_password     (also embedded in the owner database URL)
#   redis_password
#   api_key_pepper
#   api_key_pepper_previous  (only during a pepper rotation)
#   totp_encryption_key
#   session_signing_key
#   proxy_shared_secret
#
# For running the backend directly, outside Compose, the Settings defaults are
# development placeholders that work locally; override only what you need, and
# note that ENV must stay `development` for them to be accepted.
