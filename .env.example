# Copy to .env and fill in. Never commit .env.
# Secrets do NOT belong here in production: they are mounted as files under
# /run/secrets and read via pydantic-settings `secrets_dir`. See
# docs/architecture/deployment.md section 10.

# --- Environment ---------------------------------------------------------
ENV=development                 # development | production
AUTH_MODE=dev                   # tailnet | local | dev
                                # dev refuses to start when ENV=production

# Serving the internal schema is opt-in, so leaving this alone fails closed.
# Ignored entirely when ENV=production.
EXPOSE_OPENAPI=false

# --- Networking ----------------------------------------------------------
# Tailscale address of the Mac Studio. Used for host-side port binding, so
# that proxy-facing ports are never published on 0.0.0.0.
TAILNET_IP=127.0.0.1
PROXY_HOSTNAME=api.nexus.rcsl.online

# --- Datastores ----------------------------------------------------------
# The password here must match POSTGRES_PASSWORD below. In production the
# three services connect as different least-privilege accounts, each with its
# own URL, and the password comes from a mounted secret rather than from here.
DATABASE_URL=postgresql+asyncpg://nexus:dev-postgres-not-for-production@postgres:5432/nexus
REDIS_URL=redis://redis:6379/0

# `memory` is per-process, so rate limits would be counted per worker rather
# than per key. Settings refuses to start with it when ENV=production. Use it
# only when running the backend outside Compose, where there is no Redis.
CACHE_BACKEND=redis

# --- Model runtime -------------------------------------------------------
# Runtimes run natively on the macOS host, not in Docker: containers on
# macOS cannot reach the GPU. See docs/ARCHITECTURE.md section 0.1.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Frontend ------------------------------------------------------------
ADMIN_API_URL=http://admin-tailnet:8001

# Origin of the management UI, used to build invitation and password reset
# links. Configured rather than taken from the request, because the link is
# issued on whichever entrance the administrator happens to be using and must
# always point at the public one: a tailnet URL handed to someone who has no
# Tailscale is a link they cannot open.
ADMIN_BASE_URL=http://localhost:3000

# --- Sessions and invitations -------------------------------------------
# Names and units match the Settings fields exactly. They previously read
# SESSION_ABSOLUTE_TTL=12h and friends, which matched no field and parsed as
# no integer, so setting them was a silent no-op that looked configured.
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_IDLE_TTL_SECONDS=3600
INVITATION_TTL_SECONDS=259200

# How long a generated-but-unproved TOTP secret is held. Short on purpose: an
# abandoned enrolment must not leave a usable second factor waiting, and an
# expiry only costs the user a re-scan.
TOTP_ENROLMENT_TTL_SECONDS=600

# Shown by the authenticator app next to the account.
TOTP_ISSUER=RCSL AI Nexus

# --- Cookies -------------------------------------------------------------
# The `__Host-` prefix binds a cookie to this exact origin and requires
# Secure, so browsers discard it over plain HTTP. Turning COOKIE_SECURE off
# for local development therefore drops the prefix as well, and the frontend
# must be told the new name:
#
#   COOKIE_SECURE=false
#   NEXT_PUBLIC_CSRF_COOKIE=nexus_csrf
#
# Settings refuses COOKIE_SECURE=false when ENV=production.
COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-nexus_session
CSRF_COOKIE_NAME=__Host-nexus_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# --- Source restriction --------------------------------------------------
# Enforced in the application, since the public entrance is an nginx proxy
# rather than a CDN. Refuses to start in production if the database below is
# missing, rather than silently allowing every country.
ALLOWED_COUNTRIES=TW,AU
GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb

# --- Bootstrap -----------------------------------------------------------
# Creates the first admin on first login through the TAILNET entrance only,
# and only while the users table is empty. Inert thereafter.
#
# Under AUTH_MODE=dev there is no tailscale serve to inject an identity
# header, so DEV_TAILNET_LOGIN is substituted for it and everything after that
# runs unchanged. Set this to the same value to bootstrap locally.
BOOTSTRAP_ADMIN_LOGIN=
DEV_TAILNET_LOGIN=dev@localhost

# --- Resource guardrails -------------------------------------------------
# With no CDN in front of this deployment these are the only defence against
# a single caller making the machine unresponsive.
MAX_CONCURRENT_INFERENCE=2
MAX_TOKENS_CEILING=4096
MAX_CONTEXT_LENGTH=32768
REQUEST_TIMEOUT_SECONDS=300

# --- Secrets (development only; production mounts files) -----------------
# Every value below is a placeholder. Settings refuses to start with any of
# them when ENV=production, so a deployment cannot silently inherit them.
POSTGRES_USER=nexus
POSTGRES_DB=nexus
POSTGRES_PASSWORD=dev-postgres-not-for-production
REDIS_PASSWORD=dev-redis-not-for-production
API_KEY_PEPPER=dev-pepper-not-for-production
# Set only during a rotation: keys signed with the old pepper keep verifying
# until they are reissued. Leave empty otherwise.
API_KEY_PEPPER_PREVIOUS=
TOTP_ENCRYPTION_KEY=dev-totp-key-not-for-production
SESSION_SIGNING_KEY=dev-session-key-not-for-production
PROXY_SHARED_SECRET=dev-proxy-secret-not-for-production
