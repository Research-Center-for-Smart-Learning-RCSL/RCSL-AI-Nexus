# Copy to .env and fill in. Never commit .env.
# Secrets do NOT belong here in production: they are mounted as files under
# /run/secrets and read via pydantic-settings `secrets_dir`. See
# docs/architecture/deployment.md section 10.

# --- Environment ---------------------------------------------------------
ENV=development                 # development | production
AUTH_MODE=dev                   # tailnet | local | dev
                                # dev refuses to start when ENV=production

# --- Networking ----------------------------------------------------------
# Tailscale address of the Mac Studio. Used for host-side port binding, so
# that proxy-facing ports are never published on 0.0.0.0.
TAILNET_IP=127.0.0.1
PROXY_HOSTNAME=api.nexus.rcsl.online

# --- Datastores ----------------------------------------------------------
# The password here must match POSTGRES_PASSWORD below. In production the
# three services connect as different least-privilege accounts, each with its
# own URL, and the password comes from a mounted secret rather than from here.
DATABASE_URL=postgresql+asyncpg://nexus:dev-postgres-not-for-production@postgres:5432/nexus
REDIS_URL=redis://redis:6379/0

# --- Model runtime -------------------------------------------------------
# Runtimes run natively on the macOS host, not in Docker: containers on
# macOS cannot reach the GPU. See docs/ARCHITECTURE.md section 0.1.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Frontend ------------------------------------------------------------
ADMIN_API_URL=http://admin-tailnet:8001

# --- Sessions and invitations -------------------------------------------
SESSION_ABSOLUTE_TTL=12h
SESSION_IDLE_TTL=1h
INVITATION_TTL=72h

# --- Source restriction --------------------------------------------------
ALLOWED_COUNTRIES=TW,AU
GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb

# --- Bootstrap -----------------------------------------------------------
# Creates the first admin on first login through the TAILNET entrance only,
# and only while the users table is empty. Inert thereafter.
BOOTSTRAP_ADMIN_LOGIN=

# --- Resource guardrails -------------------------------------------------
# With no CDN in front of this deployment these are the only defence against
# a single caller making the machine unresponsive.
MAX_CONCURRENT_INFERENCE=2
MAX_TOKENS_CEILING=4096
MAX_CONTEXT_LENGTH=32768
REQUEST_TIMEOUT_SECONDS=300

# --- Secrets (development only; production mounts files) -----------------
# Every value below is a placeholder. Settings refuses to start with any of
# them when ENV=production, so a deployment cannot silently inherit them.
POSTGRES_USER=nexus
POSTGRES_DB=nexus
POSTGRES_PASSWORD=dev-postgres-not-for-production
REDIS_PASSWORD=dev-redis-not-for-production
API_KEY_PEPPER=dev-pepper-not-for-production
TOTP_ENCRYPTION_KEY=dev-totp-key-not-for-production
SESSION_SIGNING_KEY=dev-session-key-not-for-production
PROXY_SHARED_SECRET=dev-proxy-secret-not-for-production
