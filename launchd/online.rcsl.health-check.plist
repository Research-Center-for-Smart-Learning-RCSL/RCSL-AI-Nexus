<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>online.rcsl.health-check</string>

	<!-- Watches for the platform being up but not serving, and mails when that
	     changes. The reasoning, and what this can and cannot see, is at the top
	     of the script. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/rcslmac1/dev/RCSL-AI-Nexus/launchd/check-platform-health.sh</string>
	</array>

	<!-- Same identity as the reconciler and for the same reason: the docker
	     socket is the user's (~/.docker/run/docker.sock) and Docker Desktop runs
	     in the user's session, so root would be the wrong identity even though
	     this is a daemon. It also needs to read secrets/. -->
	<key>UserName</key>
	<string>rcslmac1</string>

	<!-- Every five minutes, and also once at load. The load-time run does not
	     check anything: launchd starts this before Docker Desktop, tailscaled or
	     any container exists, so it would find everything down and mail about a
	     platform that is still coming up. The script's boot grace (240s, below
	     the interval on purpose) suppresses it and the run rewrites the state
	     file and exits.

	     That is the whole reason RunAtLoad is true. The state file's mtime is the
	     only record that this daemon is alive, and the runbook reads it as one.
	     With RunAtLoad false the first write of a boot was the first scheduled
	     fire, five minutes in, so for those five minutes the freshest mtime
	     available predated the boot — and the runbook's "under five minutes old"
	     criterion failed on a healthy machine, at exactly the point after a
	     reboot where it tells the operator to look. The 2026-07-26 20:24 and
	     20:29 reboots were 4m37s apart and no run happened across either.

	     The grace could not have suppressed anything before 2026-07-26 either:
	     it parsed kern.boottime with a greedy pattern that captured the usec
	     field, so uptime came out as the Unix epoch and the check could only say
	     "not in grace". RunAtLoad false was load-bearing by accident. -->
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>

	<!-- The log carries events only — a state change, a heartbeat, a mail that
	     could not be sent — so reading it shows what happened rather than 288
	     lines a day of nothing. "Did it run at all" is answered by the mtime of
	     /opt/homebrew/var/nexus-health.state, which every run rewrites. -->
	<key>StandardOutPath</key>
	<string>/opt/homebrew/var/log/nexus-health.log</string>
	<key>StandardErrorPath</key>
	<string>/opt/homebrew/var/log/nexus-health.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/rcslmac1/dev/RCSL-AI-Nexus</string>
</dict>
</plist>
